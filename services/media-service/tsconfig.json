{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ES2022"
		],
		"types": [
			"node"
		],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"src/**/*",
		"prisma.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
