generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  postID    String   @id @default(uuid())
  authorID  String
  content   String
  media     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorID])
  @@index([createdAt(sort: Desc)])
}