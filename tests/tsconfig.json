{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"lib": ["ES2023", "DOM"],
		"types": ["node"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", ".results", ".report"]
}
