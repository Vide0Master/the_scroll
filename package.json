{
	"name": "the-scroll",
	"private": true,
	"workspaces": [
		"services/*",
		"packages/*"
	],
	"packageManager": "npm@12.0.2",
	"scripts": {
		"build": "turbo run build",
		"lint": "eslint . --fix",
		"dev": "dotenv -e .env -- ./dev.sh",
		"db:migrate": "dotenv -e .env -- ./migrate.sh",
		"db:generate": "dotenv -e .env -- turbo run db:generate",
		"test": "dotenv -e .env -- playwright test -c tests",
		"test:unit": "dotenv -e .env -v PW_SKIP_STACK=1 -- playwright test -c tests --project=unit",
		"test:api": "dotenv -e .env -- playwright test -c tests api/",
		"test:e2e": "dotenv -e .env -- playwright test -c tests e2e/",
		"test:health": "dotenv -e .env -- playwright test -c tests --project=health",
		"test:auth": "dotenv -e .env -- playwright test -c tests --project=auth",
		"test:navigation": "dotenv -e .env -- playwright test -c tests --project=navigation",
		"test:users": "dotenv -e .env -- playwright test -c tests --project=users",
		"test:roles": "dotenv -e .env -- playwright test -c tests --project=roles",
		"test:moderation": "dotenv -e .env -- playwright test -c tests --project=moderation",
		"test:notifications": "dotenv -e .env -- playwright test -c tests --project=notifications",
		"test:popularity": "dotenv -e .env -- playwright test -c tests --project=popularity",
		"test:qol": "dotenv -e .env -- playwright test -c tests --project=qol",
		"test:search": "dotenv -e .env -- playwright test -c tests --project=search",
		"test:profile-editor": "dotenv -e .env -- playwright test -c tests --project=profile-editor",
		"test:settings": "dotenv -e .env -- playwright test -c tests --project=settings",
		"test:posts": "dotenv -e .env -- playwright test -c tests --project=posts",
		"test:replies": "dotenv -e .env -- playwright test -c tests --project=replies",
		"test:entities": "dotenv -e .env -- playwright test -c tests --project=entities",
		"test:media": "dotenv -e .env -- playwright test -c tests --project=media",
		"test:cache": "dotenv -e .env -- playwright test -c tests --project=cache",
		"test:media-lifecycle": "dotenv -e .env -- playwright test -c tests --project=media-lifecycle",
		"test:ui": "dotenv -e .env -- playwright test -c tests --ui",
		"test:report": "playwright show-report tests/.report",
		"test:up": "dotenv -e .env -- docker compose -f dev-docker-compose.yml up -d --wait",
		"play:posts": "dotenv -e .env -v PW_PLAYGROUND=1 -- playwright test -c tests --project=playground posts.play",
		"seed:activity": "dotenv -e .env -- tsx tests/seed/activity.ts",
		"role:set": "dotenv -e .env -- npm run role:set -w @the-scroll/auth-service --",
		"containers:up": "dotenv -e .env -- docker compose -f dev-docker-compose.yml up -d --wait",
		"containers:stop": "dotenv -e .env -- docker compose -f dev-docker-compose.yml stop"
	},
	"devDependencies": {
		"@playwright/test": "1.64.0-alpha-1789764292000",
		"@types/node": "^26.4.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.6",
		"tsx": "^4.23.12",
		"turbo": "^2.10.12",
		"typescript-eslint": "^8.68.0"
	}
}
